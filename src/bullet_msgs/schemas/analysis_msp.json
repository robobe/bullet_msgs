{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "physics_id": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1},
        "stream_id": {"type": "string", "minLength": 1},
        "step_index": {"type": "integer", "minimum": 0},
        "simulation_time_s": {"type": "number", "minimum": 0},
        "measurement_us": {"type": "integer", "minimum": 0}
      },
      "required": ["physics_id", "episode_id", "stream_id", "step_index", "simulation_time_s", "measurement_us"]
    },
    "backend": {"const": "betaflight"},
    "timestamp_kind": {"const": "host_receipt"},
    "firmware": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "api": {"$ref": "#/$defs/bytes"},
            "variant": {"$ref": "#/$defs/bytes"},
            "version": {"$ref": "#/$defs/bytes"}
          },
          "required": ["api", "variant", "version"]
        }
      ]
    },
    "error": {"type": ["string", "null"]},
    "rc_frames_sent": {"type": "integer", "minimum": 0},
    "last_rc_sent_at_s": {"type": ["number", "null"], "minimum": 0},
    "msp_delivery": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requests_hz": {"type": "number", "minimum": 0},
        "responses_hz": {"type": "number", "minimum": 0},
        "queue_delay_mean_s": {"type": ["number", "null"], "minimum": 0},
        "queue_delay_max_s": {"type": ["number", "null"], "minimum": 0},
        "response_turnaround_mean_s": {"type": ["number", "null"], "minimum": 0},
        "response_turnaround_max_s": {"type": ["number", "null"], "minimum": 0},
        "attitude": {"$ref": "#/$defs/delivery_metrics"},
        "altitude": {"$ref": "#/$defs/delivery_metrics"}
      },
      "required": ["requests_hz", "responses_hz", "queue_delay_mean_s", "queue_delay_max_s", "response_turnaround_mean_s", "response_turnaround_max_s"]
    },
    "sensor_feedback": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "window_s": {"type": "number", "exclusiveMinimum": 0},
        "expected_hz": {"type": "number", "minimum": 0},
        "observed_hz": {"type": "number", "minimum": 0},
        "feedback_age_s": {"type": ["number", "null"]},
        "attitude_age_s": {"type": ["number", "null"]},
        "barometer_age_s": {"type": ["number", "null"]},
        "image_age_s": {"type": ["number", "null"]},
        "image_attitude_offset_s": {"type": ["number", "null"]},
        "vision_reason": {"type": ["string", "null"]},
        "mission_phase": {"type": "string"},
        "input_feedback_queue_depth": {"type": "integer", "minimum": 0},
        "input_dropped_feedback": {"type": "integer", "minimum": 0},
        "input_malformed_messages": {"type": "integer", "minimum": 0},
        "input_age_s": {"type": ["number", "null"], "minimum": 0},
        "output_bbox_queue_depth": {"type": "integer", "minimum": 0},
        "output_los_queue_depth": {"type": "integer", "minimum": 0},
        "output_msp_delivery_queue_depth": {"type": "integer", "minimum": 0},
        "output_dropped_bbox": {"type": "integer", "minimum": 0},
        "output_dropped_los": {"type": "integer", "minimum": 0},
        "output_dropped_msp_delivery": {"type": "integer", "minimum": 0}
      },
      "required": ["window_s", "expected_hz", "observed_hz", "feedback_age_s", "attitude_age_s", "barometer_age_s", "image_age_s", "image_attitude_offset_s", "vision_reason", "mission_phase"]
    },
    "attitude": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "roll_rad": {"type": "number"}, "pitch_rad": {"type": "number"},
            "yaw_rad": {"type": "number"}, "received_at": {"type": "number", "minimum": 0}
          },
          "required": ["roll_rad", "pitch_rad", "yaw_rad", "received_at"]
        }
      ]
    },
    "altitude": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "altitude_m": {"type": "number"}, "vertical_speed_m_s": {"type": "number"},
            "received_at": {"type": "number", "minimum": 0}
          },
          "required": ["altitude_m", "vertical_speed_m_s", "received_at"]
        }
      ]
    },
    "status": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "properties": {
            "mode_flags": {"type": "integer", "minimum": 0},
            "arming_disabled_flags": {"type": "integer", "minimum": 0},
            "received_at": {"type": "number", "minimum": 0}
          },
          "required": ["mode_flags", "arming_disabled_flags", "received_at"]
        }
      ]
    }
  },
  "required": ["schema_version", "source", "backend", "timestamp_kind", "firmware", "error", "msp_delivery", "sensor_feedback", "rc_frames_sent", "last_rc_sent_at_s", "attitude", "altitude", "status"],
  "$defs": {
    "bytes": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "delivery_metrics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "requests_hz": {"type": "number", "minimum": 0},
        "responses_hz": {"type": "number", "minimum": 0},
        "queue_delay_mean_s": {"type": ["number", "null"], "minimum": 0},
        "queue_delay_max_s": {"type": ["number", "null"], "minimum": 0},
        "response_turnaround_mean_s": {"type": ["number", "null"], "minimum": 0},
        "response_turnaround_max_s": {"type": ["number", "null"], "minimum": 0}
      },
      "required": ["requests_hz", "responses_hz", "queue_delay_mean_s", "queue_delay_max_s", "response_turnaround_mean_s", "response_turnaround_max_s"]
    }
  }
}
